# UniXNU Kernel Configuration for Xiaomi Redmi 9A (dandelion)
# MTK MT6765 (Helio G25) - 4x Cortex-A53

# Architecture
CONFIG_ARM64=y
CONFIG_ARCH_MTK=y
CONFIG_MTK_MT6765=y

# CPU
CONFIG_SMP=y
CONFIG_NR_CPUS=4
CONFIG_ARM_CPU_TOPOLOGY=y

# Memory
CONFIG_PAGE_SIZE_16KB=y
CONFIG_ARM64_VA_BITS_36=y
CONFIG_ARM64_PA_BITS_36=y

# Timer
CONFIG_ARM_ARCH_TIMER=y
CONFIG_ARM_ARCH_TIMER_EVTSTREAM=y

# Interrupts
CONFIG_ARM_GIC=y
CONFIG_ARM_GIC_V3=y

# Console
CONFIG_SERIAL_EARLYCON=y
CONFIG_SERIAL_MTK=y
CONFIG_CONSOLE_LOGLEVEL_DEFAULT=7

# Display
CONFIG_MTK_DDP=y
CONFIG_MTK_DSI=y
CONFIG_DRM_PANEL_NOVATEK_NT36525B=y

# Touch
CONFIG_INPUT_TOUCHSCREEN=y
CONFIG_TOUCHSCREEN_NOVATEK=y
CONFIG_I2C_MTK=y

# PMIC
CONFIG_MTK_PMIC=y
CONFIG_MTK_PMIC_MT6357=y
CONFIG_REGULATOR=y
CONFIG_REGULATOR_MT6357=y

# Storage
CONFIG_MMC=y
CONFIG_MMC_MTK=y
CONFIG_MMC_BLOCK=y

# USB
CONFIG_USB=y
CONFIG_USB_MU3D=y
CONFIG_USB_GADGET=y

# File systems
CONFIG_HFSPLUS_FS=y
CONFIG_APFS_FS=y

# Security
CONFIG_AMFI=y
CONFIG_SANDBOX=y

# Debug
CONFIG_DEBUG_INFO=y
CONFIG_KALLSYMS=y
CONFIG_PRINTK=y

# XNU-specific
CONFIG_XNU=y
CONFIG_XNU_PLATFORM_MTK=y
CONFIG_XNU_MACHINE_DANDELION=y
