##
#  M2 progress beacon: re-arms the TOPRGU watchdog to 2 s once DXE dispatch
#  works, so "reached DXE" is observable without a UART.
#
#  Copyright (c) Microsoft Corporation.
#  SPDX-License-Identifier: BSD-2-Clause-Patent
##
[Defines]
  INF_VERSION                    = 0x00010005
  BASE_NAME                      = PlatformProgressDxe
  FILE_GUID                      = 8E4C6D31-9F52-4A17-B6C8-3D5E7A1B9C24
  MODULE_TYPE                    = DXE_DRIVER
  VERSION_STRING                 = 1.0
  ENTRY_POINT                    = PlatformProgressDxeEntryPoint

[Sources]
  PlatformProgressDxe.c

[Packages]
  MdePkg/MdePkg.dec

[LibraryClasses]
  IoLib
  UefiBootServicesTableLib
  UefiDriverEntryPoint

#
# Consumed only, to report whether a GOP exists.  It must be listed here or the
# GUID is not linked and the build fails with
#   lld-link: error: undefined symbol: gEfiGraphicsOutputProtocolGuid
#
[Protocols]
  gEfiGraphicsOutputProtocolGuid    ## SOMETIMES_CONSUMES

#
# No dependencies on purpose: the whole point is to run as early as the
# dispatcher allows, before any driver that could hang.
#
[Depex]
  TRUE
