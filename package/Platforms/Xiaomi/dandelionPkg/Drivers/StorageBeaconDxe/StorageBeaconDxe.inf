##
#  M4 storage beacon: dispatched as soon as MsdcDxe publishes the SD/MMC
#  pass-through protocol, then does the ConnectController sweep itself and
#  reports on the panel how far eMMC -> BlockIo -> partition -> FAT got.
#
#  Copyright (c) Microsoft Corporation.
#  SPDX-License-Identifier: BSD-2-Clause-Patent
##
[Defines]
  INF_VERSION                    = 0x00010005
  BASE_NAME                      = StorageBeaconDxe
  FILE_GUID                      = 3C7A9E10-5B24-4D86-8F01-6E2B4C9D7A38
  MODULE_TYPE                    = DXE_DRIVER
  VERSION_STRING                 = 1.0
  ENTRY_POINT                    = StorageBeaconDxeEntryPoint

[Sources]
  StorageBeaconDxe.c

[Packages]
  MdePkg/MdePkg.dec

[LibraryClasses]
  UefiBootServicesTableLib
  UefiDriverEntryPoint

[Protocols]
  gEfiBlockIoProtocolGuid            ## CONSUMES
  gEfiSimpleFileSystemProtocolGuid   ## CONSUMES
  gEfiSdMmcPassThruProtocolGuid      ## CONSUMES

#
# No dependency any more (2026-10-29 20:3x).
#
# It used to depend on gEfiSdMmcPassThruProtocolGuid, i.e. on MsdcDxe having
# installed it.  MsdcDxe is now out of the firmware volume on purpose: its
# bring-up resets the controller, sends CMD0 and walks the card up from IDLE
# again, and IMG_5760 shows that a card re-initialised that way will answer
# every command and then send no data at all.  The driver that replaced it does
# the opposite -- inherit LK's controller and card state, exactly as
# bootshim/msdc.c does, which is the only configuration that has ever moved a
# byte on this board (docs/EMMC-LOG.md).  See InheritProbe().
#
# Dispatch order is therefore governed by the FV list (Include/DXE.inc), which
# places this driver after the console so its output has somewhere to go.
#
# Cell map on the panel (y 1400, 80x80, pitch 88):
#
#   6 yellow  this driver ran
#   4 purple  a BlockIo handle exists
#   7 red     connect sweep finished with no block device
#   5 green   a SimpleFileSystem mounted
#
[Depex]
  TRUE
