##
#  M5 loader: find a payload (FAT file first, firmware-volume image second),
#  LoadImage it and StartImage it, then say what happened on the panel.
#
#  Why this exists instead of BDS: BdsDxe is deliberately absent from the APRIORI
#  list (ConSplitter's console-mode negotiation dead-loops against this panel),
#  so nothing else in this firmware would ever start a second-stage image.
#
#  Copyright (c) Microsoft Corporation.
#  SPDX-License-Identifier: BSD-2-Clause-Patent
##
[Defines]
  INF_VERSION                    = 0x00010005
  BASE_NAME                      = PayloadBootDxe
  FILE_GUID                      = 8A62C1D4-77E0-4B3B-9C8E-5D41F0B2C7A6
  MODULE_TYPE                    = DXE_DRIVER
  VERSION_STRING                 = 1.0
  ENTRY_POINT                    = PayloadBootEntryPoint

[Sources]
  PayloadBootDxe.c

[Packages]
  MdePkg/MdePkg.dec
  dandelionPkg/dandelion.dec

[LibraryClasses]
  UefiBootServicesTableLib
  UefiDriverEntryPoint
  BaseLib
  BaseMemoryLib
  DebugLib

[Protocols]
  gEfiSimpleFileSystemProtocolGuid   ## CONSUMES
  gEfiFirmwareVolume2ProtocolGuid    ## CONSUMES
  gDandelionLogProtocolGuid          ## CONSUMES
  #
  # Raw block access, used only to park the firmware log in free space inside the
  # flashinfo partition (see FlushLogToFlash).
  #
  gEfiBlockIoProtocolGuid            ## CONSUMES

#
# The file-system path needs EFI_FILE_INFO to size a file before reading it, and
# the log table is published under a GUID of our own.
#
[Guids]
  gEfiFileInfoGuid                   ## SOMETIMES_CONSUMES
  gDandelionLogTableGuid             ## PRODUCES
gEfiEventExitBootServicesGuid      ## CONSUMES

#
# Always dispatched: "no payload found" is a result worth painting, and a depex
# on SimpleFileSystem would hide exactly the case we are in today (no block
# device at all).  The APRIORI list puts it last, after StorageBeaconDxe, so any
# volume that can appear has appeared.
#
[Depex]
  TRUE
