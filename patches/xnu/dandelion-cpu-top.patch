 volatile uint32_t dandelion_procs, dandelion_springboard, dandelion_backboardd;
 
+/*
+ * Per-process CPU accounting for the beat line.  Every probe so far counts events; none says which process
+ * spent the time.  Thirty-five minutes pass between SpringBoard starting and the lock screen appearing, and
+ * the only way to attribute them is to read each task's accumulated CPU time and print the largest.
+ *
+ * The snapshot is taken under proc_list_lock (task references only) and the CPU times are read after the
+ * lock is dropped, because task_info() takes its own locks.
+ */
+#define DANDELION_CPU_SLOTS 64
+#define DANDELION_CPU_TOP 5
+static task_t dandelionCpuTask[DANDELION_CPU_SLOTS];
+static int dandelionCpuPid[DANDELION_CPU_SLOTS];
+static unsigned dandelionCpuCount;
+
+static uint64_t
+dandelion_task_cpu_ms(task_t task)
+{
+	task_basic_info_64_data_t info;
+	mach_msg_type_number_t count = TASK_BASIC_INFO_64_COUNT;
+
+	if (task_info(task, TASK_BASIC_INFO_64, (task_info_t)&info, &count) != KERN_SUCCESS) {
+		return 0;
+	}
+	return (uint64_t)info.user_time.seconds * 1000ULL +
+	    (uint64_t)info.user_time.microseconds / 1000ULL +
+	    (uint64_t)info.system_time.seconds * 1000ULL +
+	    (uint64_t)info.system_time.microseconds / 1000ULL;
+}
+
+static void
+dandelion_print_cpu_top(void)
+{
+	uint64_t best[DANDELION_CPU_TOP];
+	int bestPid[DANDELION_CPU_TOP];
+	unsigned slot, rank;
+
+	for (rank = 0; rank < DANDELION_CPU_TOP; rank++) {
+		best[rank] = 0;
+		bestPid[rank] = -1;
+	}
+	for (slot = 0; slot < dandelionCpuCount; slot++) {
+		task_t task = dandelionCpuTask[slot];
+		uint64_t ms;
+		if (task == TASK_NULL) {
+			continue;
+		}
+		ms = dandelion_task_cpu_ms(task);
+		for (rank = 0; rank < DANDELION_CPU_TOP; rank++) {
+			if (ms > best[rank]) {
+				for (unsigned shift = DANDELION_CPU_TOP - 1; shift > rank; shift--) {
+					best[shift] = best[shift - 1];
+					bestPid[shift] = bestPid[shift - 1];
+				}
+				best[rank] = ms;
+				bestPid[rank] = dandelionCpuPid[slot];
+				break;
+			}
+		}
+	}
+	printf("D4K cpu:");
+	for (rank = 0; rank < DANDELION_CPU_TOP; rank++) {
+		if (bestPid[rank] < 0) {
+			break;
+		}
+		printf(" %d=%llums", bestPid[rank], (unsigned long long)best[rank]);
+	}
+	printf("\n");
+
+	for (slot = 0; slot < dandelionCpuCount; slot++) {
+		if (dandelionCpuTask[slot] != TASK_NULL) {
+			task_deallocate(dandelionCpuTask[slot]);
+			dandelionCpuTask[slot] = TASK_NULL;
+		}
+	}
+	dandelionCpuCount = 0;
+}
+
