--- a/bsd/kern/kern_exit.c
+++ b/bsd/kern/kern_exit.c
@@ -1362,9 +1362,25 @@
 abort_with_payload_internal(proc_t p,
     uint32_t reason_namespace, uint64_t reason_code,
     user_addr_t payload, uint32_t payload_size,
     user_addr_t reason_string, uint64_t reason_flags,
     uint32_t internal_flags)
 {
+	/*
+	 * Board diagnostic: a service that aborts would otherwise leave only "sig=5" in the exit trace.
+	 *
+	 * Only numbers are printed.  This runs while the kernel is delivering the abort, and reading
+	 * user memory here (copyinstr of reason_string, then copyin of the payload) has produced a
+	 * kernel data abort on this board twice, which turns a diagnosable crash into a panic -- the
+	 * opposite of what the diagnostic is for.  The process name and the exception numbers are
+	 * already enough to tell one abort from another, and DANDELION-REASON still carries the
+	 * payload text from the exit path, where copyin does work.
+	 */
+	{
+		printf("DANDELION-ABORT: pid=%d comm=%s ns=%u code=%llu payload=%u reason_string=%p\n",
+		    proc_getpid(p), p->p_comm, reason_namespace, reason_code, payload_size,
+		    (void *)reason_string);
+	}
+
 	os_reason_t exit_reason = OS_REASON_NULL;
 	kern_return_t kr = KERN_SUCCESS;
 
