--- a/bsd/kern/kern_exec.c
+++ b/bsd/kern/kern_exec.c
@@ -7113,10 +7113,27 @@
 	    (error = copyout(mountpoint, request.path, strlen(mountpoint) + 1)) != 0 ||
 	    (error = copyout(device_path, spec, strlen(device_path) + 1)) != 0 ||
 	    (error = copyout(mount_data, request.data, sizeof(mount_data))) != 0) goto done;
-	native_owner_cache_stage = 3;
-	error = mount(p, &request, &result);
-	native_owner_cache_mount_status = error;
-	if (error) goto done;
+	native_owner_cache_stage = 3;
+	/* The media that carries the volume UUID can be re-published between the query above and
+	 * this mount: the query returns the name that was live a moment earlier, and
+	 * mount_common resolves that name again with namei().  One image produced both a boot
+	 * that mounted on the first attempt and a boot that died with ENOENT on '/dev/disk3s1',
+	 * a disk that did not exist in that enumeration at all.  Re-resolve and retry, printing
+	 * every attempt, instead of deciding on one stale name. */
+	for (int attempt = 0; ; attempt++) {
+		printf("D4K mount: attempt=%d dev=%d path='%s'\n", attempt, (int)selected, device_path);
+		error = mount(p, &request, &result);
+		native_owner_cache_mount_status = error;
+		if (!error || (error != ENOENT && error != ENXIO) || attempt == 3) break;
+		tsleep((caddr_t)&native_owner_cache_stage, PRIBIO, "d4kmount", hz / 5);
+		if (!native_verified_block_volume_device(volume, &selected, device_path,
+		    sizeof(device_path))) continue;
+		strlcpy(native_owner_cache_device_path, device_path,
+		    sizeof(native_owner_cache_device_path));
+		native_owner_cache_selected_device = selected;
+		if ((error = copyout(device_path, spec, strlen(device_path) + 1)) != 0) break;
+	}
+	if (error) goto done;
 	native_owner_cache_stage = 4;
 	error = vnode_lookup(mountpoint, 0, &mounted_root, vfs_context_current());
 	if (error) goto done;
