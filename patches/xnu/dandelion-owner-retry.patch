--- a/bsd/kern/kern_exec.c
+++ b/bsd/kern/kern_exec.c
@@ -7018,6 +7018,7 @@
 #error The offline owner cache mount is a development instrument
 #endif
 extern int native_verified_block_volume_device(const char *, dev_t *, char *, size_t);
+extern int native_verified_block_candidate(int, dev_t *, char *, size_t);
 #if defined(XNU_OWNER_BOOT_MANIFEST) && XNU_OWNER_BOOT_MANIFEST
 extern int native_owner_publish_boot_manifest(dev_t, const char *, dev_t, const char *);
 #endif
@@ -7027,6 +7028,9 @@
 #endif
 extern int native_verified_block_root_authorized(dev_t);
 volatile int native_owner_cache_stage = 0;
+extern char native_verified_block_candidate_path[4][64];
+extern char native_verified_block_media_class[32];
+extern volatile int native_verified_block_candidate_count;
 volatile int native_owner_cache_status = -1;
 volatile int native_owner_cache_mount_status = -1;
 volatile int native_owner_cache_readonly = 0;
@@ -7114,8 +7118,25 @@
 	    (error = copyout(device_path, spec, strlen(device_path) + 1)) != 0 ||
 	    (error = copyout(mount_data, request.data, sizeof(mount_data))) != 0) goto done;
 	native_owner_cache_stage = 3;
-	error = mount(p, &request, &result);
-	native_owner_cache_mount_status = error;
+	/* One name cannot decide this.  The media that carries the volume UUID is re-published
+	 * while the mount runs, so the name the query returns can be a dead disk by the time
+	 * mount_common resolves it again -- measured as ENOENT and then EIO on the same
+	 * '/dev/disk3s1', in enumerations that had no disk3 at all.  The driver records an ordered
+	 * candidate list instead (the volume's own node, then its ancestor media, ending with the
+	 * window's whole media), and each candidate gets a mount attempt. */
+	for (int attempt = 0; attempt < 4; attempt++) {
+		if (attempt) {
+			if (!native_verified_block_candidate(attempt, &selected, device_path,
+			    sizeof(device_path))) break;
+			native_owner_cache_selected_device = selected;
+			strlcpy(native_owner_cache_device_path, device_path,
+			    sizeof(native_owner_cache_device_path));
+			if ((error = copyout(device_path, spec, strlen(device_path) + 1)) != 0) break;
+		}
+		error = mount(p, &request, &result);
+		native_owner_cache_mount_status = error;
+		if (!error) break;
+	}
 	if (error) goto done;
 	native_owner_cache_stage = 4;
 	error = vnode_lookup(mountpoint, 0, &mounted_root, vfs_context_current());
@@ -8184,9 +8205,12 @@
 	/* stage/status alone cannot separate the two ENOENT sites in mount_common (namei of the
 	 * device path, or apfs_vfsop_mount itself), and panic() output only reaches the panic screen,
 	 * never the console log block.  Name the device the mount was handed. */
-	if (cache_error) panic("D4K cache: err=%d stage=%d status=%d dev=%d path='%s'",
+	if (cache_error) panic("D4K cache: err=%d stage=%d status=%d dev=%d path='%s' n=%d media=%s [%s|%s|%s|%s]",
 	    cache_error, (int)native_owner_cache_stage, native_owner_cache_mount_status,
-	    (int)native_owner_cache_selected_device, native_owner_cache_device_path);
+	    (int)native_owner_cache_selected_device, native_owner_cache_device_path,
+	    (int)native_verified_block_candidate_count, native_verified_block_media_class,
+	    native_verified_block_candidate_path[0], native_verified_block_candidate_path[1],
+	    native_verified_block_candidate_path[2], native_verified_block_candidate_path[3]);
 #endif
 #if defined(XNU_OWNER_DATA_MOUNT) && XNU_OWNER_DATA_MOUNT
 	int data_error = native_owner_data_prepare(p, (user_addr_t)scratch_addr);
