+
+/*
+ * Minimal UI focus sampler, adapted from the merlinx owner-diag UI trace.  The dandelion display
+ * path already proves that backboardd submits and retires the first frames, then submissions stop
+ * while SpringBoard stays alive.  Its own unified log never reaches this console, so sample the
+ * current thread PC/LR/x16 from the kernel side.  This is diagnostic only: it never writes the
+ * framebuffer and never changes display or storage behavior.
+ */
+extern proc_t proc_find(int pid);
+extern task_t proc_task(proc_t p);
+extern void proc_rele(proc_t p);
+
+static thread_call_t dandelion_focus_call;
+static int dandelion_focus_pid[3];
+static char dandelion_focus_name[3][20];
+static boolean_t dandelion_focus_started;
+
+static int
+ dandelion_focus_slot(const char *name)
+{
+	if (!name) return -1;
+	if (!strncmp(name, "SpringBoard", 20)) return 0;
+	if (!strncmp(name, "backboardd", 20)) return 1;
+	if (!strncmp(name, "lsd", 20)) return 2;
+	return -1;
+}
+
+void
+native_diag_focus_note(int pid, const char *name)
+{
+	int slot = dandelion_focus_slot(name);
+	if (slot >= 0) {
+		dandelion_focus_pid[slot] = pid;
+		strlcpy(dandelion_focus_name[slot], name, sizeof(dandelion_focus_name[slot]));
+	}
+}
+
+void
+native_diag_focus_exit(int pid, const char *name)
+{
+	int slot = dandelion_focus_slot(name);
+	if (slot >= 0 && dandelion_focus_pid[slot] == pid)
+		dandelion_focus_pid[slot] = 0;
+}
+
+static void
+dandelion_focus_sample(thread_call_param_t, thread_call_param_t)
+{
+	for (unsigned i = 0; i < 3; i++) {
+		int pid = dandelion_focus_pid[i];
+		if (pid <= 0) continue;
+		proc_t p = proc_find(pid);
+		if (!p) continue;
+		task_t task = proc_task(p);
+		thread_t thread = THREAD_NULL;
+		if (task) {
+			task_lock(task);
+			queue_iterate(&task->threads, thread, thread_t, task_threads) {
+				thread_reference(thread);
+				break;
+			}
+			task_unlock(task);
+		}
+		if (thread != THREAD_NULL) {
+			arm_thread_state64_t state = {};
+			mach_msg_type_number_t count = ARM_THREAD_STATE64_COUNT;
+			if (machine_thread_get_state(thread, ARM_THREAD_STATE64,
+			    (thread_state_t)&state, &count) == KERN_SUCCESS) {
+				printf("DANDELION-FOCUS: pid=%d comm=%s state=%x wait=%#llx pc=%#llx lr=%#llx x16=%#llx\n",
+				    pid, dandelion_focus_name[i], thread->state,
+				    (unsigned long long)thread->wait_event,
+				    (unsigned long long)state.pc, (unsigned long long)state.lr,
+				    (unsigned long long)state.x[16]);
+			}
+			thread_deallocate(thread);
+		}
+		proc_rele(p);
+	}
+	if (dandelion_focus_call) {
+		uint64_t deadline = 0;
+		clock_interval_to_deadline(4, (uint32_t)NSEC_PER_SEC, &deadline);
+		thread_call_enter_delayed(dandelion_focus_call, deadline);
+	}
+}
+
+void
+native_diag_focus_start(void)
+{
+	if (dandelion_focus_started) return;
+	dandelion_focus_started = TRUE;
+	dandelion_focus_call = thread_call_allocate(dandelion_focus_sample, NULL);
+	if (dandelion_focus_call) {
+		uint64_t deadline = 0;
+		clock_interval_to_deadline(1, (uint32_t)NSEC_PER_SEC, &deadline);
+		thread_call_enter_delayed(dandelion_focus_call, deadline);
+	}
+}
