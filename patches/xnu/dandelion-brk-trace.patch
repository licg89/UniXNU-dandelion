--- a/osfmk/arm64/sleh.c
+++ b/osfmk/arm64/sleh.c
@@ -1239,1 +1239,55 @@
+	/*
+	 * Board diagnostic: a userland brk is an assertion, and the exit reason only records that
+	 * one happened.  The PC, the LR and the brk comment tell which trap fired; the image base
+	 * and install name say which binary it came from, which matters here because the dyld
+	 * shared cache sits in a sealed volume and cannot be resolved offline.  The faulting
+	 * thread is still current, so its map is reachable with copyin; every copy is bounded and
+	 * checked, because a fault in here would panic.
+	 */
+	{
+		uint64_t brk_pc = (uint64_t)get_saved_state_pc(state);
+		uint64_t brk_base = 0;
+		char brk_name[96];
+		brk_name[0] = 0;
+		for (uint64_t page = brk_pc & ~0xfffull; page > (brk_pc & ~0xfffull) - (8 * 1024 * 1024); page -= 0x1000) {
+			uint32_t magic = 0;
+			if (copyin((user_addr_t)page, &magic, sizeof(magic)) != 0) {
+				continue;
+			}
+			if (magic == 0xfeedfacf) {
+				brk_base = page;
+				break;
+			}
+		}
+		if (brk_base != 0) {
+			struct mach_header_64 mh;
+			if (copyin((user_addr_t)brk_base, &mh, sizeof(mh)) == 0 && mh.ncmds < 512) {
+				uint64_t cursor = brk_base + sizeof(mh);
+				for (uint32_t ci = 0; ci < mh.ncmds; ci++) {
+					struct load_command lc;
+					if (copyin((user_addr_t)cursor, &lc, sizeof(lc)) != 0 || lc.cmdsize < sizeof(lc)) {
+						break;
+					}
+					if (lc.cmd == 0xd) {
+						struct dylib_command dc;
+						if (copyin((user_addr_t)cursor, &dc, sizeof(dc)) == 0 &&
+						    dc.dylib.name.offset < lc.cmdsize) {
+							(void)copyinstr((user_addr_t)(cursor + dc.dylib.name.offset),
+							    brk_name, sizeof(brk_name), NULL);
+						}
+						break;
+					}
+					cursor += lc.cmdsize;
+				}
+			}
+		}
+		printf("DANDELION-BRK: pc=%#llx lr=%#llx comment=%#x base=%#llx off=%#llx image=%s\n",
+		    (unsigned long long)brk_pc,
+		    (unsigned long long)get_saved_state_lr(state),
+		    (unsigned)(ISS_BRK_COMMENT(esr)),
+		    (unsigned long long)brk_base,
+		    (unsigned long long)(brk_base ? brk_pc - brk_base : 0),
+		    brk_name[0] ? brk_name : "?");
+	}
+
 	codes[1] = get_saved_state_pc(state);
