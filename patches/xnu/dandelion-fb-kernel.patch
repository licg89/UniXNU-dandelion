+static void
+fb_putc(int c)
+{
+	volatile uint32_t *base;
+	uint64_t glyph;
+	uint32_t top, bottom, row, col, dy, dx, bits;
+	const uint32_t cell = 10, line = 24, rb = vinfo.v_rowbytes;
+
+	if (fb_on < 0) {
+		unsigned int on = 0;
+		fb_on = (PE_parse_boot_argn("native-fb", &on, sizeof(on)) && on == 1 &&
+		         vinfo.v_baseaddr != 0 && vinfo.v_depth == 32) ? 1 : 0;
+		if (!fb_on) {
+			return;
+		}
+	}
+	if (!fb_on) {
+		return;
+	}
+	base = (volatile uint32_t *)vinfo.v_baseaddr;
+	if (c == '\n') {
+		fb_x = 0;
+		fb_y += line;
+		return;
+	}
+	if (c == '\r') {
+		fb_x = 0;
+		return;
+	}
+	if (c < 32 || c > 126) {
+		return;
+	}
+	if (fb_x + cell > vinfo.v_width) {
+		fb_x = 0;
+		fb_y += line;
+	}
+	if (fb_y + line > vinfo.v_height) {
+		fb_x = 0;
+		fb_y = 0;
+	}
+	glyph = fb_font[c - 32];
+	top = (uint32_t)(glyph >> 32);
+	bottom = (uint32_t)glyph;
+	for (row = 0; row < 12; row++) {
+		bits = (row < 6) ? (top >> (row * 5)) : (bottom >> ((row - 6) * 5));
+		for (col = 0; col < 5; col++) {
+			if (!((bits >> col) & 1)) {
+				continue;
+			}
+			for (dy = 0; dy < 2; dy++) {
+				for (dx = 0; dx < 2; dx++) {
+					base[(uint64_t)(fb_y + row * 2 + dy) * (rb / 4) + fb_x + col * 2 + dx] = 0xFFFFFFFFu;
+				}
+			}
+		}
+	}
+	fb_x += cell;
+}
